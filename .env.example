# --- Opsional: URL publik kanonis ---
# Redirect login Google TIDAK memakai variabel ini; callback selalu memakai
# origin browser yang sedang dibuka (localhost atau domain Vercel). Jangan
# mengisi nilai localhost di environment Vercel.
# NEXT_PUBLIC_SITE_URL=https://domain-kamu.vercel.app

# --- Supabase (materi inti + bonus) ---
# Ambil dari dashboard Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: HANYA untuk menulis dari server (sync/seed admin).
# JANGAN pernah membuat variabel NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# --- Groq (dipakai admin seed dan endpoint AI publik) ---
# Ambil di https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Endpoint AI publik /api/lessons/generate ---
# Opsional: salt untuk hash IP. Jika kosong, memakai ADMIN_SEED_SECRET.
# Jangan memakai nilai yang mudah ditebak.
# AI_RATE_LIMIT_SALT=
# Batas global generate AI per hari (default 100).
# AI_GLOBAL_DAILY_LIMIT=100

# --- Endpoint admin ---
# WAJIB acak dan minimal 24 karakter. Contoh: openssl rand -hex 32
# Jangan pakai kata yang mudah ditebak; secret ini membuka endpoint tulis.
ADMIN_SEED_SECRET=
